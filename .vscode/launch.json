{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MTG Agent CLI",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/src/mtg_agent.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    },
    {
      "name": "Python: Current File",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Python: Tests",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}